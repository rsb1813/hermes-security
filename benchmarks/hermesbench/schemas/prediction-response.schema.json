{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "findings"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "task_id": {"type": "string"},
    "findings": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["finding_id", "entry_point", "critical_operation", "trace", "confidence"],
        "properties": {
          "finding_id": {"type": "string"},
          "entry_point": {"$ref": "#/$defs/location"},
          "critical_operation": {"$ref": "#/$defs/location"},
          "trace": {"type": "array", "items": {"$ref": "#/$defs/location"}},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1}
        }
      }
    }
  },
  "$defs": {
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "line"],
      "properties": {
        "file": {"type": "string"},
        "line": {"anyOf": [{"type": "integer", "minimum": 1}, {"type": "string", "pattern": "^[1-9][0-9]*-[1-9][0-9]*$"}]}
      }
    }
  }
}
